# Copy to .env (never commit .env) or set these in your host's dashboard.
PORT=8000
# Either a plain password (min 10 chars; hashed in memory at startup)...
ADMIN_PASSWORD=change-me-to-a-long-random-password
# ...or, better, a pre-computed hash from `npm run hash-password -- "your password"`:
# ADMIN_PASSWORD_HASH=scrypt$<salt>$<hash>
# Set to "production" when served over HTTPS (adds Secure cookie + HSTS).
NODE_ENV=development
# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx) so rate limits see real client IPs.
# TRUST_PROXY=1
# Postgres (e.g. Supabase). When set, data is stored in Postgres; when unset, in the JSON file below.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=disable      # only for a local Postgres without SSL
# Where the JSON database lives when DATABASE_URL is not set.
# DB_FILE=./data/grouphub.json
# 1 = insert the 15 sample groups (fake invite codes) when the database is empty.
SEED_SAMPLES=1
# Optional: fixed salt for hashing reporter/submitter IPs (keeps report de-duplication across restarts).
# IP_HASH_SALT=some-long-random-string
